<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Presionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#102A44" />
            <stroke
                android:width="1.5dp"
                android:color="#00A3FF" />
            <corners android:radius="9dp" />
            <padding
                android:left="6dp"
                android:right="6dp"
                android:top="6dp"
                android:bottom="6dp" />
        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#06111D" />
            <stroke
                android:width="1dp"
                android:color="#007BFF" />
            <corners android:radius="9dp" />
            <padding
                android:left="6dp"
                android:right="6dp"
                android:top="6dp"
                android:bottom="6dp" />
        </shape>
    </item>

</selector>
