<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:startColor="#007BFF"
                android:centerColor="#0063E6"
                android:endColor="#004FD1"
                android:angle="0" />
            <stroke
                android:width="1dp"
                android:color="#00C2FF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <gradient
                android:startColor="#13B7FF"
                android:centerColor="#007BFF"
                android:endColor="#0057E8"
                android:angle="0" />
            <stroke
                android:width="1dp"
                android:color="#00C2FF" />
        </shape>
    </item>

</selector>
