<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070A">

    <ImageView
        android:id="@+id/bgLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_login"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/capaOscura"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#12000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/contenedorLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        app:layout_constraintWidth_percent="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.50">

        <ImageView
            android:id="@+id/logoCamerinoHeader"
            android:layout_width="235dp"
            android:layout_height="60dp"
            android:src="@drawable/logo_camerino_sports_header"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true" />

        <ImageView
            android:id="@+id/imgShoe"
            android:layout_width="245dp"
            android:layout_height="105dp"
            android:layout_marginTop="-5dp"
            android:src="@drawable/img_shoe_login"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true" />

        <ImageView
            android:id="@+id/imgPlatform"
            android:layout_width="279dp"
            android:layout_height="83dp"
            android:layout_marginTop="-28dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/img_neon_platform" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenido "
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="de nuevo"
                android:textColor="#008CFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingresa con tu cuenta o crea una nueva"
            android:textColor="#D5DFEC"
            android:textSize="14sp"
            android:layout_marginTop="7dp" />

        <LinearLayout
            android:id="@+id/formularioLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CORREO ELECTRÓNICO"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_input"
                android:hint="ejemplo@camerinosports.com"
                android:inputType="textEmailAddress"
                android:maxLength="180"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#A8B0BD"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONTRASEÑA"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_input"
                android:hint="Ingresa tu contraseña"
                android:inputType="textPassword"
                android:maxLength="100"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#A8B0BD"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="9dp">

                <CheckBox
                    android:id="@+id/chkRemember"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Recordarme"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:buttonTint="#008CFF"
                    android:padding="0dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/txtForgot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Olvidaste tu contraseña?"
                    android:textColor="#00A3FF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_login"
                android:gravity="center"
                android:text="INICIAR SESIÓN"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtContinuaCon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="o continúa con"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:shadowColor="#008CFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="7" />

            <LinearLayout
                android:id="@+id/contenedorRedes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp">

                <ImageView
                    android:id="@+id/btnFacebook"
                    android:layout_width="66dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_social_button"
                    android:padding="7dp"
                    android:src="@drawable/ic_facebook"
                    android:scaleType="centerInside" />

                <ImageView
                    android:id="@+id/btnGoogle"
                    android:layout_width="66dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_social_button"
                    android:padding="7dp"
                    android:src="@drawable/ic_google"
                    android:scaleType="centerInside" />

                <ImageView
                    android:id="@+id/btnApple"
                    android:layout_width="66dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_social_button"
                    android:padding="7dp"
                    android:src="@drawable/ic_apple"
                    android:scaleType="centerInside" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenedorRegistro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿No tienes una cuenta? "
                    android:textColor="#D5DFEC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtCrearCuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crear cuenta"
                    android:textColor="#00A3FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
