<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:layout_marginStart="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#071321"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#00AFFF"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgProducto"
            android:layout_width="104dp"
            android:layout_height="94dp"
            android:contentDescription="Imagen del producto"
            android:scaleType="fitCenter"
            android:src="@drawable/producto_botin_azul"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtEtiquetaProducto"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_btn_cantidad"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="NUEVO"
            android:textColor="#00AFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtNombreProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:maxLines="2"
            android:text="Adidas Predator Elite FG"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/txtEtiquetaProducto"
            app:layout_constraintStart_toEndOf="@id/imgProducto"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtCategoriaProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Calzado deportivo"
            android:textColor="#9FB0C2"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/txtNombreProducto"
            app:layout_constraintTop_toBottomOf="@id/txtNombreProducto" />

        <TextView
            android:id="@+id/txtDisponibleProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="● Disponible"
            android:textColor="#39FF66"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/txtNombreProducto"
            app:layout_constraintTop_toBottomOf="@id/txtCategoriaProducto" />

        <TextView
            android:id="@+id/txtStockProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Stock: 8"
            android:textColor="#9FB0C2"
            android:textSize="10sp"
            app:layout_constraintBaseline_toBaselineOf="@id/txtDisponibleProducto"
            app:layout_constraintStart_toEndOf="@id/txtDisponibleProducto" />

        <TextView
            android:id="@+id/txtPrecioProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="S/ 649.00"
            android:textColor="#00AFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/txtNombreProducto"
            app:layout_constraintTop_toBottomOf="@id/txtDisponibleProducto" />

        <TextView
            android:id="@+id/btnVerDetalleProducto"
            android:layout_width="118dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_btn_continuar_pedido"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="VER DETALLE  →"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>