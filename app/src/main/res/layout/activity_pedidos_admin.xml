<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo administrativo -->
    <ImageView
        android:id="@+id/imgFondoPedidosAdmin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_admin_panel" />

    <!-- Capa oscura para mejorar la lectura -->
    <View
        android:id="@+id/capaOscuraPedidos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <!-- Encabezado -->
    <LinearLayout
        android:id="@+id/headerPedidosAdmin"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnVolverPedidosAdmin"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="#00B7FF"
            android:textSize="38sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/logoPedidosAdmin"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:contentDescription="Logo Camerino Sports"
            android:scaleType="centerInside"
            android:src="@drawable/logo_camerino_sports_header" />

        <ImageView
            android:id="@+id/imgNotificacionesPedidos"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="Notificaciones"
            android:src="@drawable/ic_bell"
            app:tint="#00B7FF" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollPedidosAdmin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerPedidosAdmin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="36dp">

            <!-- Título -->
            <TextView
                android:id="@+id/txtTituloPedidosAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pedidos recibidos"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtituloPedidosAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Administra y actualiza el estado de cada pedido"
                android:textColor="#AFC0D3"
                android:textSize="13sp" />

            <!-- Resumen -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Resumen de pedidos"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenedorResumenPedidos"
                android:layout_width="match_parent"
                android:layout_height="98dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Pendientes -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_admin_moderno"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏳"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/txtCantidadPendientes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="8"
                        android:textColor="#FFB000"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirmados"
                        android:textColor="#C4CFDA"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- En proceso -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_admin_moderno"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙"
                        android:textColor="#00B7FF"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/txtCantidadProceso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="3"
                        android:textColor="#00B7FF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preparando / camino"
                        android:textColor="#C4CFDA"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- Completados -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_admin_moderno"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textColor="#00E88A"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCantidadCompletados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="12"
                        android:textColor="#00E88A"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Completados"
                        android:textColor="#C4CFDA"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Lista de pedidos"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- PEDIDO 1 -->
            <LinearLayout
                android:id="@+id/cardPedidoUno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/fondo_resumen_pedido"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgPedidoUno"
                        android:layout_width="82dp"
                        android:layout_height="76dp"
                        android:contentDescription="Producto del pedido"
                        android:scaleType="fitCenter"
                        android:src="@drawable/producto_botin_azul" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pedido #CS-001"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Juan Pérez"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="987 654 321 · 2 productos"
                            android:textColor="#AFC0D3"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="11/06/2026 · 10:15 a. m."
                            android:textColor="#71869B"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnEliminarPedidoUno"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Eliminar pedido"
                        android:padding="8dp"
                        android:src="@drawable/ic_delete_red" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="#254158" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtEstadoPedidoUno"
                        android:layout_width="104dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_btn_cantidad"
                        android:gravity="center"
                        android:text="PENDIENTE"
                        android:textColor="#FFB000"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="S/ 1,258.00"
                        android:textColor="#00B7FF"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="13dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnVerPedidoUno"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_admin_moderno"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="VER DETALLE"
                        android:textColor="#00B7FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnEstadoPedidoUno"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_continuar_pedido"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="CAMBIAR ESTADO"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- PEDIDO 2 -->
            <LinearLayout
                android:id="@+id/cardPedidoDos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/fondo_resumen_pedido"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgPedidoDos"
                        android:layout_width="82dp"
                        android:layout_height="76dp"
                        android:contentDescription="Producto del pedido"
                        android:scaleType="fitCenter"
                        android:src="@drawable/producto_botin_blanco" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pedido #CS-002"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="María López"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="976 123 456 · 1 producto"
                            android:textColor="#AFC0D3"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="11/06/2026 · 9:40 a. m."
                            android:textColor="#71869B"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnEliminarPedidoDos"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Eliminar pedido"
                        android:padding="8dp"
                        android:src="@drawable/ic_delete_red" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="#254158" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtEstadoPedidoDos"
                        android:layout_width="104dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_btn_cantidad"
                        android:gravity="center"
                        android:text="EN PROCESO"
                        android:textColor="#00B7FF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="S/ 599.00"
                        android:textColor="#00B7FF"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="13dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnVerPedidoDos"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_admin_moderno"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="VER DETALLE"
                        android:textColor="#00B7FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnEstadoPedidoDos"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_continuar_pedido"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="CAMBIAR ESTADO"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- PEDIDO 3 -->
            <LinearLayout
                android:id="@+id/cardPedidoTres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="26dp"
                android:background="@drawable/fondo_resumen_pedido"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgPedidoTres"
                        android:layout_width="82dp"
                        android:layout_height="76dp"
                        android:contentDescription="Producto del pedido"
                        android:scaleType="fitCenter"
                        android:src="@drawable/producto_botin_negro" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pedido #CS-003"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Carlos Mendoza"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="954 321 876 · 3 productos"
                            android:textColor="#AFC0D3"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="10/06/2026 · 5:30 p. m."
                            android:textColor="#71869B"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnEliminarPedidoTres"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Eliminar pedido"
                        android:padding="8dp"
                        android:src="@drawable/ic_delete_red" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="#254158" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtEstadoPedidoTres"
                        android:layout_width="104dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_btn_cantidad"
                        android:gravity="center"
                        android:text="COMPLETADO"
                        android:textColor="#00E88A"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="S/ 1,749.00"
                        android:textColor="#00B7FF"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="13dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnVerPedidoTres"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_admin_moderno"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="VER DETALLE"
                        android:textColor="#00B7FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnEstadoPedidoTres"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_continuar_pedido"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="CAMBIAR ESTADO"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
