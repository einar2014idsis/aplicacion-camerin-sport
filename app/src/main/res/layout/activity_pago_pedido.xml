<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bgPagoPedido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_principal_camerino_sports" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000" />

    <LinearLayout
        android:id="@+id/headerPagoPedido"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnVolverPagoPedido"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/logoPagoPedido"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:contentDescription="Logo Camerino Sports"
            android:scaleType="centerInside"
            android:src="@drawable/logo_camerino_sports_header" />

        <ImageView
            android:id="@+id/icPagoPedido"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="Pago"
            android:src="@drawable/ic_bag" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollPagoPedido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerPagoPedido">

        <LinearLayout
            android:id="@+id/contenedorPagoPedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTituloPagoPedido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Metodo de pago"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtituloPagoPedido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Elige como deseas pagar tu pedido."
                android:textColor="#B8C7D9"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/cardTotalPago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/fondo_resumen_pedido"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtTotalPagoPedido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total: S/ 0.00"
                    android:textColor="#00AFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtResumenPagoPedido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tu pedido se registrara despues de confirmar el pago."
                    android:textColor="#B8C7D9"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardOpcionesPago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/opcionPagoYape"
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:background="@drawable/fondo_resumen_pedido"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_btn_continuar_pedido"
                        android:contentDescription="Yape"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/yape" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Yape Empresa"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Pago simulado con QR."
                            android:textColor="#B8C7D9"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtCheckYape"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_estado_pendiente_redondo"
                        android:gravity="center"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/opcionPagoTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/fondo_resumen_pedido"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_btn_continuar_pedido"
                        android:contentDescription="Tarjeta"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/tarjeta" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tarjeta"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Pago simulado para confirmar tu pedido."
                            android:textColor="#B8C7D9"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtCheckTarjeta"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_estado_pendiente_redondo"
                        android:gravity="center"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/formYape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/fondo_resumen_pedido"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Yape Empresa"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Pago simulado. Ingresa un numero Yape y un codigo de 6 digitos para confirmar."
                    android:textColor="#B8C7D9"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgQrYapePedido"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:background="#FFFFFF"
                        android:contentDescription="QR Yape Camerino Sports"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/qr_yape_einar"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="Confirmacion simulada"
                        android:textColor="#00AFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="No se realiza ningun cobro real"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <EditText
                    android:id="@+id/edtYapeTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_admin_moderno"
                    android:hint="Numero Yape del cliente"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:maxLength="9"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6F8194"
                    android:textSize="13sp"
                    android:visibility="visible" />

                <EditText
                    android:id="@+id/edtYapeCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_admin_moderno"
                    android:hint="Codigo de aprobacion Yape"
                    android:importantForAutofill="no"
                    android:inputType="numberPassword"
                    android:maxLength="6"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6F8194"
                    android:textSize="13sp"
                    android:visibility="visible" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/formTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/fondo_resumen_pedido"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Datos de tarjeta"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Formulario simulado. No se realiza ningun cobro real."
                    android:textColor="#B8C7D9"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/edtNumeroTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_admin_moderno"
                    android:hint="Numero de tarjeta"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:maxLength="23"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6F8194"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtFechaTarjeta"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_admin_moderno"
                        android:hint="MM/AA"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLength="5"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#6F8194"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtCvvTarjeta"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_admin_moderno"
                        android:hint="CVV"
                        android:importantForAutofill="no"
                        android:inputType="numberPassword"
                        android:maxLength="3"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#6F8194"
                        android:textSize="13sp" />

                </LinearLayout>

                <EditText
                    android:id="@+id/edtTitularTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_admin_moderno"
                    android:hint="Titular de la tarjeta"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6F8194"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtAvisoPago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Confirma tu pago para registrar el pedido en el servidor."
                android:textColor="#9FB0C2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnConfirmarPagoPedido"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="40dp"
                android:background="@drawable/bg_btn_continuar_pedido"
                android:gravity="center"
                android:text="CONFIRMAR PAGO Y PEDIDO"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
