<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bgSeguimientoPedido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_principal_camerino_sports" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000" />

    <LinearLayout
        android:id="@+id/headerSeguimientoPedido"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnVolverSeguimiento"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/logoSeguimientoPedido"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:contentDescription="Logo Camerino Sports"
            android:scaleType="centerInside"
            android:src="@drawable/logo_camerino_sports_header" />

        <ImageView
            android:id="@+id/icSeguimientoPedido"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="Seguimiento de pedido"
            android:src="@drawable/ic_bag" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollSeguimientoPedido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="34dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerSeguimientoPedido">

        <LinearLayout
            android:id="@+id/contenedorSeguimientoPedido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTituloSeguimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rastreo de pedido"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtituloSeguimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Consulta el estado y la ubicacion de tu pedido."
                android:textColor="#B8C7D9"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/cardPedidoSeguimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/fondo_resumen_pedido"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgPedidoSeguimiento"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_btn_continuar_pedido"
                        android:contentDescription="Pedido"
                        android:padding="14dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_bag" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtNumeroPedidoSeguimiento"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Pedido #CS-00048"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtEstadoPrincipalSeguimiento"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_btn_cantidad"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="En camino"
                                android:textColor="#00AFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtFechaPedidoSeguimiento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="20 mayo, 2026 · 10:30 a. m."
                            android:textColor="#B8C7D9"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="#28384C" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:text="⌖"
                        android:textColor="#00AFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Direccion de entrega"
                            android:textColor="#9FB0C2"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtDireccionSeguimiento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Av. Los Deportes 123"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:text="S/"
                        android:textColor="#00AFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pago"
                            android:textColor="#9FB0C2"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtPagoSeguimiento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Metodo no registrado"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/txtTituloEstadoPedido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Estado del pedido"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardTimelineSeguimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/fondo_resumen_pedido"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/itemEstadoConfirmado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="42dp"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtIconoConfirmado"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_btn_continuar_pedido"
                            android:gravity="center"
                            android:text="✓"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/lineaConfirmado"
                            android:layout_width="3dp"
                            android:layout_height="34dp"
                            android:background="#00AFFF" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtEstadoConfirmado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pedido confirmado"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtDetalleConfirmado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Tu pedido ha sido recibido correctamente."
                            android:textColor="#B8C7D9"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtFechaConfirmado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="20 mayo, 2026 · 10:30 a. m."
                            android:textColor="#6F8194"
                            android:textSize="10sp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemEstadoPreparando"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="42dp"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtIconoPreparando"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_btn_continuar_pedido"
                            android:gravity="center"
                            android:text="✓"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/lineaPreparando"
                            android:layout_width="3dp"
                            android:layout_height="34dp"
                            android:background="#00AFFF" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtEstadoPreparando"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Preparando pedido"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtDetallePreparando"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Estamos preparando tu pedido."
                            android:textColor="#B8C7D9"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtFechaPreparando"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="20 mayo, 2026 · 11:15 a. m."
                            android:textColor="#6F8194"
                            android:textSize="10sp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemEstadoCamino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="42dp"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/imgIconoCamino"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_estado_camion_redondo"
                            android:contentDescription="Pedido en camino"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_camion_pedido" />

                        <View
                            android:id="@+id/lineaCamino"
                            android:layout_width="2dp"
                            android:layout_height="40dp"
                            android:background="#34485F" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtEstadoCamino"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="En camino"
                            android:textColor="#00AFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtDetalleCamino"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Tu pedido esta en camino."
                            android:textColor="#B8C7D9"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtFechaCamino"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="20 mayo, 2026 · 01:45 p. m."
                            android:textColor="#6F8194"
                            android:textSize="10sp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemEstadoEntregado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="42dp"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/imgIconoEntregado"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_estado_pendiente_redondo"
                            android:contentDescription="Pedido entregado"
                            android:padding="7dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_paquete_entregado" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtEstadoEntregado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Entregado"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtDetalleEntregado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Tu pedido aun no ha sido entregado."
                            android:textColor="#B8C7D9"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <FrameLayout
                android:id="@+id/cardMapaSeguimiento"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/fondo_item_pedido"
                android:padding="14dp">

                <com.google.android.gms.maps.MapView
                    android:id="@+id/mapaSeguimientoPedido"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/txtAvisoMapaSeguimiento"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#CC06111B"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="Selecciona una ubicacion para ver el mapa del pedido"
                    android:textColor="#B8C7D9"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtRutaSeguimiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#DD06111B"
                    android:padding="10dp"
                    android:text="Ruta disponible cuando el pedido salga a reparto"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

            </FrameLayout>

            <LinearLayout
                android:id="@+id/cardRepartidorSeguimiento"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="30dp"
                android:background="@drawable/fondo_resumen_pedido"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/imgRepartidorSeguimiento"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_btn_continuar_pedido"
                    android:contentDescription="Repartidor"
                    android:padding="12dp"
                    android:src="@drawable/ic_profile" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Repartidor asignado"
                        android:textColor="#B8C7D9"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txtRepartidorSeguimiento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Carlos M."
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnLlamarRepartidor"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_card_admin_moderno"
                    android:gravity="center"
                    android:text="☎"
                    android:textColor="#00AFFF"
                    android:textSize="24sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
