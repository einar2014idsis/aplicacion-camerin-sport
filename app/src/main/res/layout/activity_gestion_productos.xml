<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bgGestionProductos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_admin_panel" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000" />

    <LinearLayout
        android:id="@+id/headerGestionProductos"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnVolverGestionProductos"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="#00AFFF"
            android:textSize="38sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/logoGestionProductos"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:contentDescription="Logo Camerino Sports"
            android:scaleType="centerInside"
            android:src="@drawable/logo_camerino_sports_header" />

        <ImageView
            android:id="@+id/icBellGestionProductos"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Notificaciones"
            android:src="@drawable/ic_bell"
            app:tint="#00AFFF" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollGestionProductos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerGestionProductos">

        <LinearLayout
            android:id="@+id/contenedorGestionProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="34dp">

            <TextView
                android:id="@+id/txtTituloGestionProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gestion de productos"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtituloGestionProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Registra, actualiza y controla el catalogo"
                android:textColor="#B8C7D9"
                android:textSize="14sp" />

            <FrameLayout
                android:id="@+id/bannerGestionProductos"
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_admin_moderno">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.9"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_admin_gestion_productos" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#77000000" />

                <LinearLayout
                    android:layout_width="230dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="start"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Catalogo deportivo"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Agrega productos con foto, precio y stock."
                        android:textColor="#C8D3E0"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnNuevoProducto"
                        android:layout_width="176dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_btn_continuar_pedido"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="+ AGREGAR PRODUCTO"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/cardFormularioProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/fondo_resumen_pedido"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtFormularioProducto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Formulario de producto"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNombreProducto"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_admin_moderno"
                    android:hint="Nombre del producto"
                    android:inputType="text"
                    android:maxLength="100"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8294A8"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <AutoCompleteTextView
                        android:id="@+id/edtCategoriaProducto"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_admin_moderno"
                        android:hint="Categoria"
                        android:inputType="none"
                        android:completionThreshold="0"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8294A8"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtTallaProducto"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_admin_moderno"
                        android:hint="Talla"
                        android:inputType="text"
                        android:maxLength="30"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8294A8"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtColorProducto"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_admin_moderno"
                        android:hint="Color"
                        android:inputType="text"
                        android:maxLength="50"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8294A8"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtPrecioProducto"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_admin_moderno"
                        android:hint="Precio"
                        android:inputType="numberDecimal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8294A8"
                        android:textSize="13sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/edtStockProducto"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_admin_moderno"
                    android:hint="Stock"
                    android:inputType="number"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8294A8"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgPreviewProducto"
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:background="@drawable/bg_card_admin_moderno"
                        android:clickable="true"
                        android:contentDescription="Imagen del producto"
                        android:focusable="true"
                        android:padding="8dp"
                        android:scaleType="fitCenter" />

                    <EditText
                        android:id="@+id/edtImagenProducto"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_admin_moderno"
                        android:clickable="false"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:hint="Imagen seleccionada"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8294A8"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnGuardarProducto"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_continuar_pedido"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="GUARDAR"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnLimpiarProducto"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_admin_moderno"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="LIMPIAR"
                        android:textColor="#00AFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtListaProductosAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Productos registrados"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtProductosVaciosAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/fondo_item_pedido"
                android:gravity="center"
                android:padding="16dp"
                android:text="No hay productos registrados"
                android:textColor="#B8C7D9"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/contenedorProductosAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/itemProductoAdminUno"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/itemProductoAdminDos"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/itemProductoAdminTres"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
