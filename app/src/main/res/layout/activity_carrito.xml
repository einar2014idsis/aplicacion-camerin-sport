<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#02060D">

    <!-- Fondo -->
    <ImageView
        android:id="@+id/fondoPedido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_principal_camerino_sports"
        android:scaleType="centerCrop"
        android:alpha="0.95" />

    <!-- Contenido -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPedido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="86dp">

            <!-- Barra superior -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/topBarPedido"
                android:layout_width="match_parent"
                android:layout_height="48dp">

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_menu"
                    android:scaleType="fitCenter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/logoCamerino"
                    android:layout_width="210dp"
                    android:layout_height="49dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_camerino_sports_header"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <FrameLayout
                    android:id="@+id/contenedorCarritoTop"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:id="@+id/btnCarritoTop"
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_cart_active"
                        android:scaleType="centerInside" />

                    <TextView
                        android:id="@+id/badgeCarrito"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_badge_cart"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#FFFFFF"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Título -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/btnVolverPedido"
                    android:layout_width="30dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/txtTituloPedido"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Mi pedido"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/btnVolverPedido"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/btnVolverPedido" />

                <TextView
                    android:id="@+id/txtSubtituloPedido"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Revisa tus productos antes de continuar"
                    android:textColor="#A8B0BD"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="@id/txtTituloPedido"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtTituloPedido" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCarrito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

            <!-- Producto 1 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/itemPedido1"
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/fondo_item_pedido"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/imgProducto1"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/producto_botin_destacado_negro_azul"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/txtProducto1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:text="Adidas Predator Elite FG"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintStart_toEndOf="@id/imgProducto1"
                    app:layout_constraintEnd_toStartOf="@id/btnEliminar1"
                    app:layout_constraintTop_toTopOf="@id/imgProducto1" />

                <ImageView
                    android:id="@+id/btnEliminar1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="3dp"
                    android:src="@drawable/ic_delete_red"
                    android:scaleType="centerInside"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/txtProducto1" />

                <TextView
                    android:id="@+id/txtInfoProducto1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Talla: 42  |  Color: Azul/Negro"
                    android:textColor="#A8B0BD"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="@id/txtProducto1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtProducto1" />

                <TextView
                    android:id="@+id/txtDisponible1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="●  Disponible"
                    android:textColor="#4DE36B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/txtProducto1"
                    app:layout_constraintTop_toBottomOf="@id/txtInfoProducto1" />

                <LinearLayout
                    android:id="@+id/cantidad1"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    app:layout_constraintStart_toStartOf="@id/txtProducto1"
                    app:layout_constraintTop_toBottomOf="@id/txtDisponible1">

                    <ImageView
                        android:id="@+id/btnMenos1"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_btn_cantidad"
                        android:padding="9dp"
                        android:src="@drawable/ic_minus"
                        android:scaleType="centerInside" />

                    <TextView
                        android:id="@+id/txtCantidad1"
                        android:layout_width="38dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btnMas1"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_btn_cantidad"
                        android:padding="9dp"
                        android:src="@drawable/ic_plus"
                        android:scaleType="centerInside" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtPrecio1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S/ 649.00"
                    android:textColor="#008CFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/txtPrecioUnitario1" />

                <TextView
                    android:id="@+id/txtPrecioUnitario1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precio unitario"
                    android:textColor="#A8B0BD"
                    android:textSize="9sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/cantidad1" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Producto 2 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/itemPedido2"
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/fondo_item_pedido"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/imgProducto2"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/producto_botin_blanco"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/txtProducto2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:text="Nike Mercurial Vapor 16"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintStart_toEndOf="@id/imgProducto2"
                    app:layout_constraintEnd_toStartOf="@id/btnEliminar2"
                    app:layout_constraintTop_toTopOf="@id/imgProducto2" />

                <ImageView
                    android:id="@+id/btnEliminar2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="3dp"
                    android:src="@drawable/ic_delete_red"
                    android:scaleType="centerInside"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/txtProducto2" />

                <TextView
                    android:id="@+id/txtInfoProducto2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Talla: 41  |  Color: Blanco"
                    android:textColor="#A8B0BD"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="@id/txtProducto2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtProducto2" />

                <TextView
                    android:id="@+id/txtDisponible2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="●  Disponible"
                    android:textColor="#4DE36B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/txtProducto2"
                    app:layout_constraintTop_toBottomOf="@id/txtInfoProducto2" />

                <LinearLayout
                    android:id="@+id/cantidad2"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    app:layout_constraintStart_toStartOf="@id/txtProducto2"
                    app:layout_constraintTop_toBottomOf="@id/txtDisponible2">

                    <ImageView
                        android:id="@+id/btnMenos2"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_btn_cantidad"
                        android:padding="9dp"
                        android:src="@drawable/ic_minus"
                        android:scaleType="centerInside" />

                    <TextView
                        android:id="@+id/txtCantidad2"
                        android:layout_width="38dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btnMas2"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_btn_cantidad"
                        android:padding="9dp"
                        android:src="@drawable/ic_plus"
                        android:scaleType="centerInside" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtPrecio2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S/ 599.00"
                    android:textColor="#008CFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/txtPrecioUnitario2" />

                <TextView
                    android:id="@+id/txtPrecioUnitario2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Precio unitario"
                    android:textColor="#A8B0BD"
                    android:textSize="9sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/cantidad2" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Resumen -->
            <LinearLayout
                android:id="@+id/resumenPedido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/fondo_resumen_pedido"
                android:orientation="vertical"
                android:padding="14dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/txtSubtotalCantidadPedido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subtotal (0 productos)"
                        android:textColor="#D5DFEC"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtSubtotalPedido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="S/ 0.00"
                        android:textColor="#D5DFEC"
                        android:textSize="13sp" />

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Envío"
                        android:textColor="#D5DFEC"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="Gratis"
                        android:textColor="#D5DFEC"
                        android:textSize="13sp" />

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="#253040" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtTotalPedido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="S/ 1,258.00"
                        android:textColor="#008CFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                </RelativeLayout>

            </LinearLayout>

            <!-- Botón confirmar -->
            <FrameLayout
                android:id="@+id/btnContinuarPedido"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_continuar_pedido"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="CONTINUAR PEDIDO"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="18dp"
                    android:src="@drawable/ic_arrow_right"
                    android:scaleType="centerInside" />

            </FrameLayout>

            <!-- Compra segura -->
            <LinearLayout
                android:id="@+id/contenedorCompraSegura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="9dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_security_shield"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Compra 100% segura"
                        android:textColor="#C8D4E3"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tus datos están protegidos"
                        android:textColor="#8B949E"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Menú inferior -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="bottom"
        android:background="#0D1117"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INICIO"
                android:textColor="#5A6370"
                android:textSize="9sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCategorias"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_grid"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CATEGORÍAS"
                android:textColor="#5A6370"
                android:textSize="9sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCarrito"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cart"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/badgeCarritoBottom"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge_cart"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CARRITO"
                android:textColor="#007BFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_profile"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERFIL"
                android:textColor="#5A6370"
                android:textSize="9sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
